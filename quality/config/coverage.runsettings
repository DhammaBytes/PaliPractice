<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[PaliPractice]*</Include>
          <Exclude>[PaliPractice.Tests]*</Exclude>
          <ExcludeByFile>**/obj/**;**/Generated/**;**/*.g.cs;**/*.g.i.cs;**/*.generated.cs</ExcludeByFile>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
